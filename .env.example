# ============================================
# SUPPORT DASHBOARD - ENVIRONMENT VARIABLES
# ============================================

# Backend Server
PORT=5000
VITE_API_URL=http://localhost:5000

# ============================================
# MICROSOFT GRAPH API CONFIGURATION
# ============================================
# Set to 'true' to enable Microsoft Graph API
# Set to 'false' to use mock users (default)
USE_GRAPH_API=false

# Azure AD Application Registration Details
# Get these from: https://portal.azure.com > Azure Active Directory > App registrations
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here

# ============================================
# ASSIGNMENT EMAIL NOTIFICATIONS
# ============================================
APP_BASE_URL=http://localhost:5173
NOTIFY_FROM_EMAIL=support-dashboard@yourcompany.com
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your-mailbox@yourcompany.com
SMTP_PASS=your-app-password-or-smtp-password

# ============================================
# NOTES FOR SETUP
# ============================================
# 1. Create Azure AD App Registration:
#    - Go to https://portal.azure.com
#    - Azure Active Directory > App registrations > New registration
#    - Name: "Support Dashboard API"
#    - Add API permissions: User.Read.All, User.ReadWrite.All
#    - Create a client secret
#
# 2. Update the values above with your Azure details
#
# 3. Set USE_GRAPH_API=true when ready
#
# 4. Keep .env file secure - never commit to git!
